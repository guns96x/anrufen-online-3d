[node name="NPC_Elder" parent="." instance=ExtResource("4_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.2, 0, -49.2)
npc_name = "Mayor of Guanlin (观林镇镇长)"
dialogue_text = "Welcome to Guanlin Town! Wild boars from the south forest are trampling our fields and threatening the village road. Venture past the south gate and defeat 3 Wild Boars to protect the town!"

[node name="NPC_Militia" parent="." instance=ExtResource("4_npc")]
transform = Transform3D(0.707107, 0, 0.707107, 0, 1, 0, -0.707107, 0, 0.707107, -6.4, 0, -25.2)
npc_name = "Militia Captain (民兵队长)"
dialogue_text = "Recruit! Practice your sword swings on the training dummies, then march south. Forest Spiders have nested past the boar fields. Clear out 3 of them for the militia!"
quest_id = 80002

[node name="NPC_Weaponsmith" parent="." instance=ExtResource("4_npc")]
transform = Transform3D(-0.707107, 0, -0.707107, 0, 1, 0, 0.707107, 0, -0.707107, 8, 0, -10.8)
npc_name = "Weaponsmith (武器商人)"
dialogue_text = "Finest steel blades forged from Guanlin iron ore! Hunt 2 Scavenger Jackals in the deep south forest and bring me their tusks, and I'll forge you a blade worthy of a knight."
quest_id = 80003

